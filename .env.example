# Laufzeitumgebung: development, test oder production
APP_ENV=development
APP_DEBUG=false

# In Produktion durch einen zufälligen geheimen Wert ersetzen.
APP_SECRET_KEY=replace-me
DATABASE_URL=postgresql+psycopg://flaechenschmiede:replace-me@db:5432/flaechenschmiede

PUBLIC_REGISTRATION_ENABLED=false
EMAIL_ENABLED=false
PASSWORD_RESET_ENABLED=false
EMAIL_VERIFICATION_ENABLED=false

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

EXPORT_DIRECTORY=/var/lib/flaechenschmiede/exports
